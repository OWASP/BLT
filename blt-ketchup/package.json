    "bugs": {
      "url": "https://github.com/OWASP-BLT/BLT-Ketchup/issues"
    },
    "homepage": "https://github.com/OWASP-BLT/BLT-Ketchup#readme",
    "devDependencies": {
      "@fortawesome/fontawesome-free": "^6.5.0",
      "tailwindcss": "^3.4.19"
    }
