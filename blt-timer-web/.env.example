# BLT Timer Web environment variables
# Copy this file to .dev.vars for local Wrangler development.
# Production secrets should be set with:
#   npx wrangler secret put SESSION_SECRET --env production

# Required in development and production.
# Use a long random value. Example generator:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-session-secret

# Optional app metadata for local scripts/UI copy.
APP_ENV=development
APP_BASE_URL=http://localhost:8787
