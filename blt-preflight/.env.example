# BLT-Preflight Environment Configuration
# Copy this file to .env and fill in your API keys

# ─────────────────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────────────────

PREFLIGHT_SERVER_PORT=8000
PREFLIGHT_DEBUG=false

# ─────────────────────────────────────────────────────────────────────────────
# RAG Pipeline Configuration
# ─────────────────────────────────────────────────────────────────────────────

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_index

# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Primary LLM Provider: gemini (default), openai, or ollama
LLM_PROVIDER=gemini

# Gemini API Key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (if using offline LLM)
# Leave as-is for Docker, or change if running locally
OLLAMA_BASE_URL=http://ollama:11434

# ─────────────────────────────────────────────────────────────────────────────
# GitHub Integration (Optional)
# ─────────────────────────────────────────────────────────────────────────────

# GitHub token for posting comments on PRs
GITHUB_TOKEN=your_github_token_here

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
