{
    "compilerOptions": {
      "target": "ES2022",
      "module": "ES2022",
      "moduleResolution": "bundler",
      "lib": ["ES2022"],
      "types": ["@cloudflare/workers-types"],
      "strict": true,
      "skipLibCheck": true,
      "noEmit": true,
      "isolatedModules": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules"]
  }