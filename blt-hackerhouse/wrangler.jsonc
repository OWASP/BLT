{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hackerhouse",
	"main": "backend/src/worker.py",
	"compatibility_date": "2026-07-19",
	"compatibility_flags": [
		"python_workers",
		"disable_python_external_sdk"
	],
	"assets": {
		"directory": "UI"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	},
	"routes": [
		{
			"pattern": "hackerhouse.owaspblt.org",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "HH_DB",
			"database_name": "hackerhouse",
			"database_id": "d6789df0-779d-4ca6-902b-a4c45aaca7d9",
			"migrations_dir": "backend/migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "WEBSOCKET_ROOM",
				"class_name": "WebSocketRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"WebSocketRoom"
			]
		}
	],
	"queues": {
		"producers": [
			{
				"queue": "pipeline-events",
				"binding": "PIPELINE_QUEUE"
			}
		],
		"consumers": [
			{
				"queue": "pipeline-events",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5
			}
		]
	},
	// No "triggers": blt-cron holds the account's cron trigger and calls
	// POST /__scheduled every 5 minutes (secret CRON_SECRET, shared with blt-cron).
	"vars": {
		"BLT_API_BASE_URL": "https://api.owaspblt.org/v2",
		"LOG_LEVEL": "INFO",
		"FORGE_URL": "https://git.owaspblt.org",
		"FORGE_REPO": "owasp-blt/BLT",
		"FORGE_REF": "main",
		"FORGE_BOT_AUTHORS": "owasp-blt-actions,forkmesh",
		"FORGE_BACKFILL_DAYS": "7",
		"FORGE_MAX_EVENTS": "300"
	}
}
