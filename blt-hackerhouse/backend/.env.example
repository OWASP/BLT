# BLT-Hackerhouse Environment Configuration
# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.

# --- Forge (git.owaspblt.org): the main source, read anonymously ---
# FORGE_URL=https://git.owaspblt.org
# FORGE_REPO=owasp-blt/BLT
# FORGE_REF=main
# FORGE_BOT_AUTHORS=owasp-blt-actions,forkmesh
# FORGE_BACKFILL_DAYS=7
# FORGE_MAX_EVENTS=300

# --- Scheduling ---
# Shared with blt-cron, which calls POST /__scheduled with X-BLT-Cron-Secret.
CRON_SECRET=

# --- GitLab webhook (optional external source) ---
# Secret token configured in GitLab webhook settings. Used to verify incoming webhooks.
GITLAB_WEBHOOK_SECRET=

# --- BLT API Integration ---
# Base URL for the OWASP BLT API.
BLT_API_BASE_URL=https://api.owaspblt.org/v2

# API key for X-BLT-API-Key header authentication.
BLT_API_KEY=

# --- Database ---
# Path to the SQLite database file. Defaults to blt_hackerhouse.db in the backend directory.
# DATABASE_PATH=blt_hackerhouse.db

# --- Logging ---
# Python logging level. One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
# LOG_LEVEL=INFO
