{
  "name": "blt-sizzle-checkin",
  "version": "1.0.0",
  "description": "Organization-based async daily check-in app for OWASP BLT teams",
  "main": "workers/main.py",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "bash deploy.sh",
    "env:push": "bash scripts/push-env.sh",
    "tail": "wrangler tail",
    "db:create": "wrangler d1 create sizzle-db",
    "db:migrate:dev": "bash scripts/migrate.sh dev",
    "db:migrate:prod": "bash scripts/migrate.sh prod",
    "db:query": "wrangler d1 execute sizzle-db --command",
    "test": "python -m unittest discover tests -v"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "python",
    "checkin",
    "organizations",
    "async",
    "owasp-blt"
  ],
  "author": "OWASP BLT",
  "license": "Apache-2.0",
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
