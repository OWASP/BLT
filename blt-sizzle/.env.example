# Cloudflare Python Worker environment variables
# Copy to .env for local development. Never commit real secrets.
# For production secrets, use: wrangler secret put <NAME>
# Generate secret values with: openssl rand -base64 32

APP_NAME="BLT Sizzle"
APP_URL=http://localhost:8787
WORKER_HOST=localhost:8787

# Production: wrangler secret put ENCRYPTION_KEY
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Production: wrangler secret put OTP_SECRET
OTP_SECRET=replace-with-openssl-rand-base64-32

# Production: wrangler secret put SESSION_SECRET
SESSION_SECRET=replace-with-openssl-rand-base64-32

EMAIL_PROVIDER=sendgrid

# Production: wrangler secret put EMAIL_API_KEY
EMAIL_API_KEY=replace-with-email-provider-api-key

EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME="BLT Sizzle"

DEFAULT_TIMEZONE=UTC
DEBUG=true
