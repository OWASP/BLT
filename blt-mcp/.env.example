# Example environment configuration for BLT-MCP
# Copy this file to .env and configure your settings

# (Optional) Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- Cloudflare Workers AI (For AI Triage) ---
# Your Cloudflare Account ID (found in the dashboard URL or Workers AI dashboard)
CF_ACCOUNT_ID=your_account_id_here
# Cloudflare API Token with "Workers AI" Read permissions
CF_API_TOKEN=your_api_token_here

# --- GitLab Integration (For Vision-to-Issue pipeline) ---
GITLAB_API_TOKEN=your_gitlab_pat_here

# BLT API Configuration
BLT_API_BASE=https://api.owaspblt.org
BLT_API_KEY=your_api_key_here
